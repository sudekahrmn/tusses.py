import numpy as np
import matplotlib.pyplot as plt
import sounddevice as sd

# ======================
# Parametreler
# ======================
fs = 8000        # Örnekleme frekansı
T = 0.3          # Süre (saniye)
N = int(fs * T)  # Örnek sayısı
t = np.arange(N) / fs

# ======================
# 7 Tuşu Frekansları
# ======================
f_low = 852
f_high = 1209

# ======================
# Sinyal üretimi
# ======================
signal = np.sin(2*np.pi*f_low*t) + np.sin(2*np.pi*f_high*t)

# Normalizasyon (clipping önleme)
signal = signal / 2

# ======================
# Grafik
# ======================
plt.plot(t, signal)
plt.title("DTMF - 7 Tuşu (852 Hz + 1209 Hz)")
plt.xlabel("Zaman (s)")
plt.ylabel("Genlik")
plt.show()

# ======================
# Ses Çalma
# ======================
sd.play(signal, fs)
sd.wait()
